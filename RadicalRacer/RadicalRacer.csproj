<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <RollForward>Major</RollForward>
    <PublishReadyToRun>false</PublishReadyToRun>
    <TieredCompilation>false</TieredCompilation>
  </PropertyGroup>
  <PropertyGroup>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Icon.ico</ApplicationIcon>
  </PropertyGroup>
  <ItemGroup>
    <None Remove="Icon.ico" />
    <None Remove="Icon.bmp" />
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Include="Icon.ico">
      <LogicalName>Icon.ico</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="Icon.bmp">
      <LogicalName>Icon.bmp</LogicalName>
    </EmbeddedResource>
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="MonoGame.Framework.DesktopGL" Version="3.8.*" />
    <PackageReference Include="MonoGame.Content.Builder.Task" Version="3.8.*" />
  </ItemGroup>

  <!--
    FBX models with embedded texture references cause MonoGame's content pipeline
    to generate auto-named textures (e.g. track1_0.xnb) in Content\bin\DesktopGL\
    that are not automatically copied to the game output by the MonoGame build task.
    This target ensures all built content (including those auto-generated textures)
    is copied to the output directory after every build.
  -->
  <Target Name="CopyAutoGeneratedContent" AfterTargets="Build">
    <ItemGroup>
      <AutoGeneratedContent Include="$(MSBuildProjectDirectory)\Content\bin\DesktopGL\**\*.*" />
    </ItemGroup>
    <Copy SourceFiles="@(AutoGeneratedContent)"
          DestinationFolder="$(OutputPath)Content\%(RecursiveDir)"
          SkipUnchangedFiles="true" />
  </Target>

</Project>